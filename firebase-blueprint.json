{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "userId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "email": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "Account": {
      "collection": "accounts",
      "fields": {
        "id": { "type": "string", "required": true },
        "username": { "type": "string", "required": true },
        "displayName": { "type": "string", "required": true },
        "passwordHash": { "type": "string", "required": true },
        "salt": { "type": "string", "required": true },
        "securityQuestion1": { "type": "string", "required": false },
        "securityAnswer1Hash": { "type": "string", "required": false },
        "securityQuestion2": { "type": "string", "required": false },
        "securityAnswer2Hash": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "PersonHisaab": {
      "collection": "users/{userId}/persons",
      "fields": {
        "id": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "mobile": { "type": "string", "required": false },
        "principalAmount": { "type": "number", "required": true },
        "rate": { "type": "number", "required": true },
        "denaDate": { "type": "string", "required": true },
        "paymentMode": { "type": "string", "required": false },
        "monthlyInterest": { "type": "number", "required": true },
        "completedMonths": { "type": "number", "required": true },
        "totalMonths": { "type": "number", "required": true },
        "interestAmount": { "type": "number", "required": true },
        "totalInterestPaid": { "type": "number", "required": false },
        "totalPrincipalPaid": { "type": "number", "required": false },
        "interestDue": { "type": "number", "required": false },
        "principalDue": { "type": "number", "required": false },
        "totalAmount": { "type": "number", "required": true },
        "status": { "type": "string", "required": true },
        "paidDate": { "type": "string", "required": false },
        "note": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "PaymentRecord": {
      "collection": "users/{userId}/payments",
      "fields": {
        "id": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "receiptNumber": { "type": "string", "required": true },
        "personId": { "type": "string", "required": true },
        "personName": { "type": "string", "required": true },
        "paymentDate": { "type": "string", "required": true },
        "amount": { "type": "number", "required": true },
        "paymentType": { "type": "string", "required": true },
        "paymentMethod": { "type": "string", "required": true },
        "note": { "type": "string", "required": false },
        "previousDue": { "type": "number", "required": false },
        "remainingDue": { "type": "number", "required": false },
        "createdAt": { "type": "string", "required": true }
      }
    },
    "InterestRecord": {
      "collection": "users/{userId}/interestRecords",
      "fields": {
        "id": { "type": "string", "required": true },
        "userId": { "type": "string", "required": true },
        "personId": { "type": "string", "required": true },
        "month": { "type": "string", "required": true },
        "dueDate": { "type": "string", "required": true },
        "principalBase": { "type": "number", "required": true },
        "rate": { "type": "number", "required": true },
        "interestAmount": { "type": "number", "required": true },
        "paidAmount": { "type": "number", "required": false },
        "remainingAmount": { "type": "number", "required": false },
        "status": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true }
      }
    }
