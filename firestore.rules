rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles and all user subcollections (persons, payments, interestRecords, trash)
    match /users/{userId} {
      allow read, write: if true;

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Accounts for multi-device login & password verification across devices
    match /accounts/{username} {
      allow read, write: if true;
    }
  }
}
